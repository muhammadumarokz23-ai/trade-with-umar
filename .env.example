# ==============================================================================
# UMAR WITH TRADE — ENVIRONMENT CONFIGURATION (NO SECRETS IN VERSION CONTROL)
# ==============================================================================

# --- AI ANALYST (SERVER-SIDE ONLY) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- APPLICATION URL ---
APP_URL="MY_APP_URL"
PORT=3000

# --- PYTHON FASTAPI BACKEND ---
PYTHON_BACKEND_URL="http://localhost:8000"
PYTHON_BACKEND_PORT=8000

# --- POSTGRESQL DATABASE (SQLAlchemy) ---
DATABASE_URL="postgresql+asyncpg://umar_user:umar_password@localhost:5432/umar_with_trade"

# --- LIVE MARKET DATA & ORDER FLOW PROVIDERS (OPTIONAL / ENHANCED) ---
# Crypto (Public Binance Spot/Futures market data works without keys; keys unlock private endpoints)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# Forex & Stocks (Optional institutional feeds; public Yahoo Finance fallback used if empty)
FINNHUB_API_KEY=""
ALPHAVANTAGE_API_KEY=""
POLYGON_API_KEY=""
TWELVEDATA_API_KEY=""

# Order Flow / Bookmap Add-on (Optional external Bookmap bridge)
BOOKMAP_API_KEY=""
BOOKMAP_WS_URL=""

# News & Economic Calendar (Optional; public RSS / CryptoCompare used by default)
NEWS_API_KEY=""
TRADING_ECONOMICS_KEY=""

# --- NOTIFICATIONS ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- EXECUTION SAFEGUARDS (LIVE TRADING DISABLED BY DEFAULT) ---
LIVE_TRADING_ENABLED="false"
MAX_DAILY_LOSS_PCT="3.0"
MAX_OPEN_POSITIONS="4"
